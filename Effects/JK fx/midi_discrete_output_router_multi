desc:MIDI Discrete Router — Multi Out
//author: JK Scripts
//tags: MIDI routing randomizer discrete output multi

slider1:num_ch=16<2,16,1>Channels
slider2:skip_ch=4<0,16,1>Skip (0=none, 4=LFE)
slider3:no_repeat=1<0,15,1>No Repeat
slider4:hold_ms=5000<100,30000,100>Hold (ms)
slider5:min_copies=1<1,8,1>Min Copies
slider6:max_copies=2<1,8,1>Max Copies

@init

// Memory layout:
// ch_free[0..15]           16 slots  — when each channel becomes free
// note_ch_count[16..143]  128 slots  — how many channels each note was sent to
// note_ch_map[144..1167] 1024 slots  — up to 8 channel assignments per note (note*8+i)
// hist_buf[1168..1183]     16 slots  — recent channel history for no-repeat
// pool_buf[1184..1199]     16 slots  — candidate pool (scratch)
// last_ch_disp[1200..1207]  8 slots  — channels from last event, for GFX

ch_free       = 0;
note_ch_count = 16;
note_ch_map   = 144;
hist_buf      = 1168;
pool_buf      = 1184;
last_ch_disp  = 1200;

hist_len    = 0;
last_note_n = -1;
last_copies = 0;

i = 0; loop(16,  ch_free[i]      = 0;  i += 1);
i = 0; loop(128, note_ch_count[i]= 0;  i += 1);
i = 0; loop(16,  hist_buf[i]     = -1; i += 1);
i = 0; loop(8,   last_ch_disp[i] = -1; i += 1);

@slider
min_copies = max(1, min(8, floor(slider5)));
max_copies = max(min_copies, min(8, floor(slider6)));

@block

now      = time_precise();
skip_idx = skip_ch - 1;

while (midirecv(offset, msg1, msg2, msg3)) (

  status = msg1 & 0xF0;

  // ============ NOTE ON ============
  (status == 0x90 && msg3 > 0) ? (

    note = msg2;

    // How many channels this note targets
    copies = min_copies + floor(rand(max_copies - min_copies + 1));
    usable = num_ch - (skip_ch > 0 && skip_ch <= num_ch ? 1 : 0);
    copies = min(copies, usable);

    // Clamp no_repeat so it can't exclude everything
    eff_nr = min(max(floor(no_repeat), 0), num_ch - 2);

    // --- Build priority pool (deduplicated, priority-ordered) ---

    // Pass 1: free AND not in recent history
    n = 0; g = 0;
    loop(num_ch,
      (skip_ch == 0 || g != skip_idx) ? (
        (now >= ch_free[g]) ? (
          in_h = 0; hh = 0;
          loop(min(eff_nr, hist_len),
            hist_buf[hh] == g ? in_h = 1;
            hh += 1;
          );
          !in_h ? (pool_buf[n] = g; n += 1;);
        );
      );
      g += 1;
    );

    // Pass 2: free but in history
    g = 0;
    loop(num_ch,
      (skip_ch == 0 || g != skip_idx) ? (
        (now >= ch_free[g]) ? (
          dup = 0; pi = 0;
          loop(n, pool_buf[pi] == g ? dup = 1; pi += 1;);
          !dup ? (pool_buf[n] = g; n += 1;);
        );
      );
      g += 1;
    );

    // Pass 3: any eligible not yet in pool (busy channels as last resort)
    g = 0;
    loop(num_ch,
      (skip_ch == 0 || g != skip_idx) ? (
        dup = 0; pi = 0;
        loop(n, pool_buf[pi] == g ? dup = 1; pi += 1;);
        !dup ? (pool_buf[n] = g; n += 1;);
      );
      g += 1;
    );

    // Partial Fisher-Yates: select `actual` channels from pool
    actual = min(copies, n);
    pi = 0;
    loop(actual,
      ri = pi + floor(rand(n - pi));
      tmp = pool_buf[pi]; pool_buf[pi] = pool_buf[ri]; pool_buf[ri] = tmp;
      pi += 1;
    );

    // Store assignments and send note-ons
    note_ch_count[note] = actual;
    pi = 0;
    loop(actual,
      ch = pool_buf[pi];
      note_ch_map[note * 8 + pi] = ch;
      ch_free[ch] = 99999999;
      midisend(offset, 0x90 | ch, note, msg3);
      pi += 1;
    );

    // Push all chosen channels onto history (oldest of this batch at front)
    pi = actual - 1;
    loop(actual,
      ch = pool_buf[pi];
      sh = min(hist_len, 15);
      while (sh > 0) (hist_buf[sh] = hist_buf[sh - 1]; sh -= 1;);
      hist_buf[0] = ch;
      hist_len < 16 ? hist_len += 1;
      pi -= 1;
    );

    // GFX state
    last_note_n = note;
    last_copies = actual;
    pi = 0;
    loop(8,
      last_ch_disp[pi] = pi < actual ? pool_buf[pi] : -1;
      pi += 1;
    );

  // ============ NOTE OFF ============
  ) : (status == 0x80 || (status == 0x90 && msg3 == 0)) ? (

    note = msg2;
    cnt  = note_ch_count[note];
    cnt > 0 ? (
      pi = 0;
      loop(cnt,
        ch = note_ch_map[note * 8 + pi];
        ch_free[ch] = now + hold_ms * 0.001;
        status == 0x80 ? (
          midisend(offset, 0x80 | ch, note, msg3);
        ) : (
          midisend(offset, 0x90 | ch, note, 0);
        );
        pi += 1;
      );
      note_ch_count[note] = 0;
    ) : (
      midisend(offset, msg1, msg2, msg3);
    );

  // ============ OTHER MIDI ============
  ) : (
    midisend(offset, msg1, msg2, msg3);
  );

);


@gfx 420 120

gfx_clear = 0x111111;
gfx_setfont(1, "Arial", 15, 'b');

// Last event: show note and all channels it went to
gfx_set(1, 1, 1);
gfx_x = 10; gfx_y = 10;
last_note_n >= 0 ? (
  sprintf(#s, "Note %d ->", last_note_n);
  pi = 0;
  loop(last_copies,
    ch = last_ch_disp[pi];
    ch >= 0 ? (
      strcat(#s, sprintf(#t, "  Ch %d", ch + 1));
    );
    pi += 1;
  );
  gfx_drawstr(#s);
) : (
  gfx_drawstr("Ready - play a note");
);

// Available channels
now_gfx = time_precise();
free_n = 0; gg = 0;
loop(num_ch,
  (skip_ch == 0 || gg != skip_idx) ? (
    now_gfx >= ch_free[gg] ? free_n += 1;
  );
  gg += 1;
);
usable_gfx = num_ch - (skip_ch > 0 && skip_ch <= num_ch ? 1 : 0);

gfx_setfont(1, "Arial", 13, 0);
gfx_set(0.6, 1, 0.6);
gfx_x = 10; gfx_y = 38;
gfx_drawstr(sprintf(#, "Available: %d / %d", free_n, usable_gfx));

// Settings summary
gfx_set(0.65, 0.65, 0.65);
gfx_x = 10; gfx_y = 62;
gfx_drawstr(sprintf(#, "Copies: %d-%d", min_copies, max_copies));

gfx_x = 10; gfx_y = 82;
gfx_drawstr(sprintf(#, "Hold: %dms  |  No Repeat: %d  |  Skip: ch%d",
  hold_ms, no_repeat, skip_ch));
