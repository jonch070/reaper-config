desc:MIDI Discrete Output Router
//author: JK
//tags: MIDI routing randomizer discrete output

slider1:num_ch=16<2,16,1>Channels
slider2:skip_ch=4<0,16,1>Skip (0=none, 4=LFE)
slider3:no_repeat=1<0,15,1>No Repeat
slider4:hold_ms=5000<100,30000,100>Hold (ms)

@init

// Memory: ch_free_at[0..15], note_ch[16..143], hist[144..159], pool[160..175]
ch_free = 0;
note_map = 16;
hist_buf = 144;
pool_buf = 160;
hist_len = 0;
last_out = -1;

i = 0; loop(128, note_map[i] = -1; i += 1);
i = 0; loop(16, ch_free[i] = 0; i += 1);
i = 0; loop(16, hist_buf[i] = -1; i += 1);


@block

now = time_precise();
skip_idx = skip_ch - 1;

while (midirecv(offset, msg1, msg2, msg3)) (

  status = msg1 & 0xF0;

  // ============ NOTE ON ============
  (status == 0x90 && msg3 > 0) ? (

    // Clamp no_repeat
    eff_nr = no_repeat;
    (eff_nr > num_ch - 2) ? eff_nr = num_ch - 2;
    (eff_nr < 0) ? eff_nr = 0;

    // --- Pass 1: free + not in history ---
    n = 0;
    g = 0;
    loop(num_ch,
      (skip_ch == 0 || g != skip_idx) ? (
        (now >= ch_free[g]) ? (
          in_h = 0;
          (eff_nr > 0) ? (
            hh = 0;
            loop(eff_nr,
              (hh < hist_len) ? (
                (hist_buf[hh] == g) ? in_h = 1;
              );
              hh += 1;
            );
          );
          (in_h == 0) ? (
            pool_buf[n] = g;
            n += 1;
          );
        );
      );
      g += 1;
    );

    // --- Pass 2: free but in history ---
    (n == 0) ? (
      g = 0;
      loop(num_ch,
        (skip_ch == 0 || g != skip_idx) ? (
          (now >= ch_free[g]) ? (
            pool_buf[n] = g;
            n += 1;
          );
        );
        g += 1;
      );
    );

    // --- Pass 3: any eligible ---
    (n == 0) ? (
      g = 0;
      loop(num_ch,
        (skip_ch == 0 || g != skip_idx) ? (
          pool_buf[n] = g;
          n += 1;
        );
        g += 1;
      );
    );

    // Pick random
    chosen = pool_buf[floor(rand(n))];

    // Update history
    (hist_len < 16) ? (
      sh = hist_len;
    ) : (
      sh = 15;
    );
    while (sh > 0) (
      hist_buf[sh] = hist_buf[sh - 1];
      sh -= 1;
    );
    hist_buf[0] = chosen;
    (hist_len < 16) ? hist_len += 1;

    // Channel is busy until note-off + hold
    ch_free[chosen] = 99999999;

    // Store note -> channel mapping
    note_map[msg2] = chosen;
    last_out = chosen;

    // Send note-on on chosen MIDI channel
    midisend(offset, 0x90 | chosen, msg2, msg3);


  // ============ NOTE OFF ============
  ) : (status == 0x80 || (status == 0x90 && msg3 == 0)) ? (

    ch = note_map[msg2];
    (ch >= 0) ? (
      // Channel free after hold period
      ch_free[ch] = now + hold_ms / 1000;
      note_map[msg2] = -1;

      // Send note-off on same channel as note-on
      (status == 0x80) ? (
        midisend(offset, 0x80 | ch, msg2, msg3);
      ) : (
        midisend(offset, 0x90 | ch, msg2, 0);
      );
    ) : (
      midisend(offset, msg1, msg2, msg3);
    );


  // ============ OTHER MIDI ============
  ) : (
    // CCs, pitchbend, etc: pass through unchanged
    midisend(offset, msg1, msg2, msg3);
  );

);


@gfx 420 80

gfx_setfont(1, "Arial", 16);

// Last routed output
gfx_set(1, 1, 1);
gfx_x = 10; gfx_y = 8;
(last_out >= 0) ? (
  gfx_drawstr(sprintf(#, "Last -> Ch %d  (Out %d)", last_out + 1, last_out + 1));
) : (
  gfx_drawstr("Ready - play a note");
);

// Free channel count
now_gfx = time_precise();
free_n = 0;
gg = 0;
loop(num_ch,
  (skip_ch == 0 || gg != skip_idx) ? (
    (now_gfx >= ch_free[gg]) ? free_n += 1;
  );
  gg += 1;
);

usable = num_ch;
(skip_ch > 0 && skip_ch <= num_ch) ? usable -= 1;

gfx_set(0.6, 1, 0.6);
gfx_x = 10; gfx_y = 32;
gfx_drawstr(sprintf(#, "Available: %d / %d", free_n, usable));

// Settings summary
gfx_set(0.7, 0.7, 0.7);
gfx_x = 10; gfx_y = 56;
gfx_drawstr(sprintf(#, "Hold: %dms | NoRepeat: %d | Skip: %d",
  hold_ms, no_repeat, skip_ch));
