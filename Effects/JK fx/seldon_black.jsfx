desc:Seldon Black
tags: midi generator stochastic orchestral
author: JK Scripts
about:
  Stochastic orchestral note generator. Takes held MIDI notes as pitch material
  and fires events at a tempo-synced rate, scattering each event across random
  octaves and MIDI channels. Requires transport to be running.
  Pitch derives from held input notes (not random chromaticism) — octave is
  randomized within the Bottom/Top Octave offset range. Each step can fire
  across multiple channels simultaneously (Channels per Trigger) with multiple
  voices per channel. Probability controls whether each step fires at all.
  Non-note MIDI (CC, pitch bend) passes through unchanged.

slider1:0<-4,4,1>Bottom Octave (offset from input)
slider2:0<-4,4,1>Top Octave (offset from input)
slider3:16<0.25,64,0.25>Rate
slider4:70<0,100,0.1>Probability (%)
slider5:10<1,100,0.1>Note Len Min (% of step)
slider6:40<1,100,0.1>Note Len Max (% of step)
slider7:16<1,16,1>Instruments (MIDI ch 1-N)
slider8:90<1,127,1>Max Velocity
slider9:30<1,127,1>Min Velocity
slider10:60<0,127,1>Fallback Note (no MIDI input)
slider11:0<0,200,1>Jitter Min (ms)
slider12:50<0,200,1>Jitter Max (ms)
slider13:0<0,1,1>Rate Mode (0=Sub/beat  1=Beats/note)
slider14:0<0,1,1>Note Len Mode (0=% of step  1=ms)
slider15:100<1,2000,1>Note Len Min (ms)
slider16:500<1,2000,1>Note Len Max (ms)
slider17:1<1,8,1>Voices per Channel
slider18:0<0,1,1>Mono Ch (0=poly  1=mono per channel)
slider19:1<1,16,1>Channels per Trigger
slider20:0<0,1,1>Unique Notes (0=off  1=unique per trigger)
slider21:0<0,1,1>No Ch Repeat (0=off  1=avoid last step channels)

@init
MAX_NOTES = 256;
MAX_HELD  = 32;
note_buf    = 0;              // [note, ch, end_beat] x MAX_NOTES
note_count  = 0;
held_buf    = MAX_NOTES * 3;  // held input note numbers
held_count  = 0;
chan_pool   = held_buf + MAX_HELD;    // 16 slots — channel selection pool
last_ch_buf = chan_pool + 16;         // 16 slots — channels used last step
note_pool   = last_ch_buf + 16;       // 16 slots — note assigned per triggered channel
last_ch_count = 0;
last_playing = 0;
flash = 0;

@slider
bot_oct       = floor(slider1);
top_oct       = max(bot_oct, floor(slider2));
rate_val      = max(0.25, slider3);
rate_mode     = floor(slider13);
prob          = slider4 * 0.01;
note_len_min  = slider5 * 0.01;
note_len_max  = max(note_len_min, slider6 * 0.01);
num_ch        = max(1, min(16, floor(slider7)));
max_vel       = max(1, min(127, floor(slider8)));
min_vel       = max(1, min(max_vel, floor(slider9)));
fallback      = max(0, min(127, floor(slider10)));
min_jit_ms    = max(0, floor(slider11));
max_jit_ms    = max(min_jit_ms, floor(slider12));
note_len_mode = floor(slider14);
nlen_min_ms   = max(1, slider15);
nlen_max_ms   = max(nlen_min_ms, slider16);
voices        = max(1, min(8, floor(slider17)));
mono_ch       = floor(slider18);
ch_per_trig   = max(1, min(16, floor(slider19)));
unique_notes  = floor(slider20);
no_ch_repeat  = floor(slider21);

@block

// --- MIDI input: track held notes, block note passthrough ---
while (midirecv(moff, msg1, msg2, msg3)) (
  st = msg1 & 0xF0;

  (st == 0x90 && msg3 > 0) ? (
    already = 0; jj = 0;
    while (jj < held_count) (held_buf[jj] == msg2 ? already = 1; jj += 1;);
    (!already && held_count < MAX_HELD) ? (
      held_buf[held_count] = msg2;
      held_count += 1;
    );
  );

  (st == 0x80 || (st == 0x90 && msg3 == 0)) ? (
    jj = 0;
    while (jj < held_count) (
      held_buf[jj] == msg2 ? (
        held_count -= 1;
        held_buf[jj] = held_buf[held_count];
      ) : (jj += 1);
    );
  );

  // Pass through non-note MIDI (CC, pitch bend, etc.)
  (st != 0x90 && st != 0x80) ? midisend(moff, msg1, msg2, msg3);
);

// --- Transport ---
playing = (play_state == 1 || play_state == 5);

!playing ? (
  last_playing ? (
    jj = 0;
    while (jj < note_count) (
      midisend(0, 0x80 | floor(note_buf[jj*3+1]), floor(note_buf[jj*3]), 0);
      jj += 1;
    );
    note_count = 0;
    last_ch_count = 0;
  );
  last_playing = 0;
) : (
  last_playing = 1;

  rate_mode == 0 ? (
    step = 4.0 / rate_val;  // Sub: rate_val steps per beat
  ) : (
    step = rate_val;         // Slow: rate_val beats between notes
  );

  bps = tempo / (60.0 * srate);
  bs  = beat_position;
  be  = bs + samplesblock * bps;

  // Pending note-offs
  i = 0;
  while (i < note_count) (
    eb = note_buf[i*3+2];
    (eb >= bs && eb < be) ? (
      off = max(0, min(samplesblock-1, floor((eb-bs)/bps)));
      midisend(off, 0x80 | floor(note_buf[i*3+1]), floor(note_buf[i*3]), 0);
      note_count -= 1;
      i < note_count ? (
        note_buf[i*3]   = note_buf[note_count*3];
        note_buf[i*3+1] = note_buf[note_count*3+1];
        note_buf[i*3+2] = note_buf[note_count*3+2];
      );
    ) : (i += 1);
  );

  // Step boundaries
  fs = ceil(bs/step - 0.000000001);
  ls = floor((be - 0.000000001)/step);

  s = fs;
  while (s <= ls) (
    sb = s * step;
    on = max(0, min(samplesblock-1, floor((sb-bs)/bps)));

    // Probability applies per-step: whole event fires or doesn't
    rand(1) < prob ? (

      // 1. Build channel pool: available channels first, then last-used
      //    Pass 1: channels NOT used last step
      pool_size = 0;
      ci = 0;
      while (ci < num_ch) (
        in_last = 0; li = 0;
        while (no_ch_repeat && li < last_ch_count) (last_ch_buf[li] == ci ? in_last = 1; li += 1;);
        !in_last ? (chan_pool[pool_size] = ci; pool_size += 1;);
        ci += 1;
      );
      avail_count = pool_size;
      //    Pass 2: channels that WERE used last step (fallback if needed)
      ci = 0;
      while (ci < num_ch) (
        in_last = 0; li = 0;
        while (no_ch_repeat && li < last_ch_count) (last_ch_buf[li] == ci ? in_last = 1; li += 1;);
        in_last ? (chan_pool[pool_size] = ci; pool_size += 1;);
        ci += 1;
      );

      // Shuffle available portion
      ci = 0;
      while (ci < avail_count) (
        rr = ci + floor(rand(avail_count - ci));
        tmp = chan_pool[ci]; chan_pool[ci] = chan_pool[rr]; chan_pool[rr] = tmp;
        ci += 1;
      );
      actual_cpt = min(ch_per_trig, num_ch);
      // If we need more channels than are available, also shuffle last-used portion
      actual_cpt > avail_count ? (
        ci = avail_count;
        while (ci < num_ch) (
          rr = ci + floor(rand(num_ch - ci));
          tmp = chan_pool[ci]; chan_pool[ci] = chan_pool[rr]; chan_pool[rr] = tmp;
          ci += 1;
        );
      );

      // 2. Generate one note per triggered channel
      ci = 0;
      while (ci < actual_cpt) (
        base     = held_count > 0 ? held_buf[floor(rand(held_count))] : fallback;
        pc       = floor(base) % 12;
        base_oct = floor(base / 12);
        oct_span = top_oct - bot_oct + 1;
        oct      = base_oct + bot_oct + floor(rand(oct_span));
        n        = max(0, min(127, oct * 12 + pc));

        // Unique notes: retry with different octave until note is distinct
        unique_notes ? (
          already_used = 0; ni = 0;
          while (ni < ci) (note_pool[ni] == n ? already_used = 1; ni += 1;);
          attempts = 0;
          while (already_used && attempts < 20) (
            oct = base_oct + bot_oct + floor(rand(oct_span));
            n   = max(0, min(127, oct * 12 + pc));
            already_used = 0; ni = 0;
            while (ni < ci) (note_pool[ni] == n ? already_used = 1; ni += 1;);
            attempts += 1;
          );
        );
        note_pool[ci] = n;
        ci += 1;
      );

      // 3. Fire: for each triggered channel, fire voices notes
      ci = 0;
      while (ci < actual_cpt) (
        ch = chan_pool[ci];
        n  = note_pool[ci];

        vv = 0;
        while (vv < voices) (
          v    = min_vel + floor(rand(max_vel - min_vel + 1));
          jit  = floor((min_jit_ms + rand(max(0, max_jit_ms - min_jit_ms))) * srate / 1000.0);
          on_j = max(0, min(samplesblock-1, on + jit));

          // Mono Ch: release any existing note on this channel before firing
          mono_ch ? (
            ki = 0;
            while (ki < note_count) (
              floor(note_buf[ki*3+1]) == ch ? (
                midisend(on_j, 0x80 | ch, floor(note_buf[ki*3]), 0);
                note_count -= 1;
                ki < note_count ? (
                  note_buf[ki*3]   = note_buf[note_count*3];
                  note_buf[ki*3+1] = note_buf[note_count*3+1];
                  note_buf[ki*3+2] = note_buf[note_count*3+2];
                );
              ) : (ki += 1);
            );
          );

          midisend(on_j, 0x90 | ch, n, v);
          flash = srate * 0.12;

          // Note length
          note_len_mode == 0 ? (
            ne_len = note_len_min + rand(max(0, note_len_max - note_len_min));
            ne = sb + step * ne_len;
          ) : (
            len_ms = nlen_min_ms + rand(max(0, nlen_max_ms - nlen_min_ms));
            ne = sb + len_ms / 1000.0 * tempo / 60.0;
          );

          ne < be ? (
            eo = max(on_j+1, min(samplesblock-1, floor((ne-bs)/bps)));
            midisend(eo, 0x80 | ch, n, 0);
          ) : (
            note_count < MAX_NOTES ? (
              note_buf[note_count*3]   = n;
              note_buf[note_count*3+1] = ch;
              note_buf[note_count*3+2] = ne;
              note_count += 1;
            );
          );

          vv += 1;
        );
        ci += 1;
      );

      // 4. Update last_ch_buf for no_ch_repeat
      no_ch_repeat ? (
        last_ch_count = actual_cpt;
        ci = 0;
        while (ci < actual_cpt) (last_ch_buf[ci] = chan_pool[ci]; ci += 1;);
      );
    );
    s += 1;
  );

  flash > 0 ? flash -= samplesblock;
);

@gfx 420 240
gfx_clear = 0x0e0e1a;

// Title + trigger dot
gfx_setfont(1, "Arial", 15, 'b');
flash > 0 ? gfx_set(0.25, 0.85, 1.0) : gfx_set(0.35, 0.45, 0.65);
gfx_x = 14; gfx_y = 12;
gfx_drawstr("SELDON BLACK");
flash > 0 ? gfx_set(0.2, 0.8, 1.0, flash/(srate*0.12)) : gfx_set(0.08, 0.18, 0.28);
gfx_circle(396, 22, 10, 1, 1);

// Held notes
gfx_setfont(1, "Arial", 10, 0);
gfx_x = 14; gfx_y = 44;
held_count > 0 ? (
  gfx_set(0.35, 0.48, 0.68);
  gfx_drawstr("HELD: ");
  jj = 0;
  while (jj < min(held_count, 12)) (
    gfx_set(0.6, 0.85, 1.0);
    sprintf(#t, "%d ", floor(held_buf[jj]));
    gfx_drawstr(#t);
    jj += 1;
  );
) : (
  gfx_set(0.25, 0.32, 0.45);
  sprintf(#t, "No input — fallback: %d", fallback);
  gfx_drawstr(#t);
);

// Octave bar
gfx_set(0.35, 0.48, 0.68);
gfx_x = 14; gfx_y = 64;
gfx_drawstr("OCTAVE OFFSET");

bar_x = 14; bar_y = 78; bar_w = 392; bar_h = 14;
gfx_set(0.08, 0.10, 0.18);
gfx_rect(bar_x, bar_y, bar_w, bar_h);
mid_x = bar_x + floor(bar_w / 2);
gfx_set(0.18, 0.24, 0.38);
gfx_line(mid_x, bar_y, mid_x, bar_y + bar_h - 1);
lx = bar_x + floor((bot_oct + 4) / 8.0 * bar_w);
hx = bar_x + floor((top_oct + 4) / 8.0 * bar_w);
hx <= lx ? hx = lx + 4;
gfx_set(0.15, 0.55, 1.0, 0.8);
gfx_rect(lx, bar_y, hx - lx, bar_h);
gfx_set(0.75, 0.88, 1.0);
gfx_x = lx; gfx_y = bar_y + bar_h + 3;
sprintf(#t, "%+d", bot_oct); gfx_drawstr(#t);
gfx_x = max(hx - 14, lx + 16); gfx_y = bar_y + bar_h + 3;
sprintf(#t, "%+d", top_oct); gfx_drawstr(#t);

// Rate label
disp_step = rate_mode == 0 ? 4.0 / rate_val : rate_val;
disp_step >= 8 ? (
  sprintf(#rstr, "%g bars", disp_step / 4);
) : disp_step >= 1 ? (
  sprintf(#rstr, "%g beat(s)", disp_step);
) : (
  sprintf(#rstr, "1/%g beat", 1.0 / disp_step);
);
rate_mode == 0 ? strcat(#rstr, " [Sub]") : strcat(#rstr, " [Slow]");

// Note len label
note_len_mode == 0 ? (
  sprintf(#lstr, "%.0f-%.0f%% [step]", note_len_min*100, note_len_max*100);
) : (
  sprintf(#lstr, "%d-%dms", floor(nlen_min_ms), floor(nlen_max_ms));
);

// Read new sliders directly to avoid @slider/@gfx thread lag
disp_voices  = max(1, min(8,  floor(slider17)));
disp_mono    = floor(slider18);
disp_cpt     = max(1, min(16, floor(slider19)));
disp_un      = floor(slider20);
disp_ncr     = floor(slider21);

// Parameters line 1
gfx_set(0.45, 0.60, 0.82);
gfx_x = 14; gfx_y = 112;
sprintf(#t, "Rate: %s    Prob: %.0f%%    Jitter: %d-%dms", #rstr, prob*100, min_jit_ms, max_jit_ms);
gfx_drawstr(#t);

// Parameters line 2: channels, voices, mono
gfx_x = 14; gfx_y = 126;
(disp_voices > 1 || disp_mono || disp_cpt > 1) ? gfx_set(0.6, 0.82, 1.0) : gfx_set(0.45, 0.60, 0.82);
sprintf(#t, "Len: %s    Ch/step: %d    V/ch: %d    %s",
  #lstr, disp_cpt, disp_voices, disp_mono ? "MONO" : "poly");
gfx_drawstr(#t);

// Parameters line 3: unique notes, no ch repeat
gfx_x = 14; gfx_y = 140;
(disp_un || disp_ncr) ? gfx_set(0.6, 0.82, 1.0) : gfx_set(0.35, 0.48, 0.68);
sprintf(#t, "Unique notes: %s    No ch repeat: %s",
  disp_un ? "ON" : "off", disp_ncr ? "ON" : "off");
gfx_drawstr(#t);

// Channel boxes
disp_ch = max(1, min(16, floor(slider7)));
gfx_x = 14; gfx_y = 164;
gfx_set(0.35, 0.48, 0.68);
gfx_drawstr("CH:");

ci = 0;
while (ci < disp_ch && ci < 16) (
  cx = 46 + ci * 22;
  cy = 160;
  act = 0; ni = 0;
  while (ni < note_count) (note_buf[ni*3+1] == ci ? act = 1; ni += 1;);
  act ? gfx_set(0.15, 0.65, 1.0) : gfx_set(0.08, 0.13, 0.22);
  gfx_rect(cx, cy, 18, 18);
  gfx_set(0.85, 0.92, 1.0);
  gfx_x = cx + (ci < 9 ? 5 : 2); gfx_y = cy + 4;
  sprintf(#t, "%d", ci+1);
  gfx_drawstr(#t);
  ci += 1;
);

// Status
gfx_set(0.3, 0.42, 0.62);
gfx_x = 14; gfx_y = 194;
sprintf(#t, "Active: %d    Held: %d", note_count, held_count);
gfx_drawstr(#t);

gfx_set(0.2, 0.28, 0.42);
gfx_x = 14; gfx_y = 213;
gfx_drawstr("Route each MIDI channel to a different instrument track");
